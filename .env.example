# AI Provider: "anthropic" or "azure"
AI_PROVIDER=azure

# Anthropic (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Azure OpenAI (required if AI_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Microsoft Graph (app-only / client-credentials) — central mailbox the job reads from
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_MAILBOX=eod@owndays.com.au
# Production: certificate (private key file kept OUTSIDE the repo, strict ACL, gitignored)
GRAPH_CERT_THUMBPRINT=
GRAPH_CERT_KEY_FILE=
# Public cert (.cer) — used to warn in the run notification before expiry
GRAPH_CERT_FILE=secrets/eod-mail-reader.cer
GRAPH_CERT_WARN_DAYS=30
# Dev only: client secret (max 24 months, always expires)
GRAPH_CLIENT_SECRET=

# Timezone for deriving send_date (local calendar day) from Graph UTC datetimes
REPORT_TIMEZONE=Australia/Sydney

# Logging
LOG_FILE=eod_processor.log

# SMTP Notification
SMTP_SERVER=
SMTP_PORT=25
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EOD Processor
# Comma-separated for multiple recipients
SMTP_TO_SUCCESS=
SMTP_TO_ERROR=

# JSON Output
JSON_OUTPUT_DIR=output
REGISTER_ID=1

# Store email → store code mapping (JSON object)
STORE_MAP={"sydney@owndays.com.au": "OWND01", "owndaysburwood@gmail.com": "OWND02", "westfieldhurstville@owndays.com": "OWND03", "chatswood@owndays.com.au": "OWND04"}

# Fallback store identification when From is rewritten by a distribution list (DMARC).
# Keyword (case-insensitive) matched against the From display name, then the email body.
STORE_NAME_MAP={"sydney": "OWND01", "burwood": "OWND02", "hurstville": "OWND03", "chatswood": "OWND04"}
# Distribution-list addresses reports may be forwarded through (comma-separated).
STORE_FORWARDER_ADDRESSES=au.owndays.eod.report@bluebellgroup.com

# SFTP upload (leave FTP_HOST empty to skip upload)
# Uses SSH File Transfer Protocol (not plain FTP/FTPS)
FTP_HOST=
FTP_PORT=22
FTP_USERNAME=
FTP_PASSWORD=
FTP_DIRECTORY=/
